<?xml version="1.0" encoding="utf-8"?>
<!-- Быстрые действия долгого тапа по иконке приложения. Тап открывает
     MainActivity с ACTION_PUSH_TAP и extra «push_shortcut» — дальше как тап
     по уведомлению (MessagePushHandler.tapFromIntent → PushManager). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="new_message"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_new_message"
        android:shortcutShortLabel="@string/shortcut_new_message"
        android:shortcutLongLabel="@string/shortcut_new_message">
        <intent
            android:action="net.iperon.messenger.PUSH_TAP"
            android:targetPackage="net.iperon.messenger"
            android:targetClass="net.iperon.messenger.MainActivity">
            <extra android:name="push_shortcut" android:value="new_message" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="search"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_search"
        android:shortcutShortLabel="@string/shortcut_search"
        android:shortcutLongLabel="@string/shortcut_search">
        <intent
            android:action="net.iperon.messenger.PUSH_TAP"
            android:targetPackage="net.iperon.messenger"
            android:targetClass="net.iperon.messenger.MainActivity">
            <extra android:name="push_shortcut" android:value="search" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="saved_messages"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_saved_messages"
        android:shortcutShortLabel="@string/shortcut_saved_messages"
        android:shortcutLongLabel="@string/shortcut_saved_messages">
        <intent
            android:action="net.iperon.messenger.PUSH_TAP"
            android:targetPackage="net.iperon.messenger"
            android:targetClass="net.iperon.messenger.MainActivity">
            <extra android:name="push_shortcut" android:value="saved_messages" />
        </intent>
    </shortcut>
</shortcuts>
