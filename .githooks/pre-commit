#!/bin/sh
# Git pre-commit hook. Runs the `dart_pre_commit` checks (format + analyze, see
# the `dart_pre_commit:` config in pubspec.yaml) against staged files.
#
# Enabled repo-wide via `git config core.hooksPath .githooks`. New clones must
# run that once (or `dart run dart_pre_commit`), since git config is not cloned.
exec dart run dart_pre_commit
